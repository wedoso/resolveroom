# Public application origin
PUBLIC_APP_URL=http://localhost:5173
ENVIRONMENT=development

# Human authentication. Development mode uses explicit local identities.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Neutral Judge. `mock` is deterministic and requires no external key.
JUDGE_PROVIDER=mock
JUDGE_API_URL=https://api.openai.com/v1/responses
JUDGE_API_KEY=
JUDGE_MODEL=gpt-5-mini

# Optional email delivery. `console` persists in-app notifications only.
EMAIL_PROVIDER=console
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=ResolveRoom <notifications@example.com>

# Cloudflare deployment values are configured through Wrangler bindings.
CLOUDFLARE_ACCOUNT_ID=
