{
  "name": "resolveroom",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "bin": {
    "resolveroom": "scripts/resolveroom-agent.mjs"
  },
  "files": [
    "scripts/resolveroom-agent.mjs",
    "scripts/resolveroom-runner.mjs",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm run build",
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"wrangler dev --port 8787 --var ENVIRONMENT:development --var PUBLIC_APP_URL:http://localhost:5173 --var JUDGE_PROVIDER:mock\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "wrangler dev --port 8787 --var ENVIRONMENT:development --var PUBLIC_APP_URL:http://localhost:8787 --var JUDGE_PROVIDER:mock",
    "prebuild": "npm run agent:bundle",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:agent-e2e": "npm run build && node scripts/local-agent-e2e.mjs",
    "test:cli-package": "node scripts/test-cli-package.mjs",
    "db:migrate:local": "wrangler d1 migrations apply resolveroom --local",
    "db:migrate:remote": "npm run deploy:config && wrangler d1 migrations apply resolveroom --remote --config wrangler.deploy.toml",
    "seed": "tsx scripts/seed.ts",
    "demo": "tsx scripts/demo.ts",
    "agent": "node scripts/resolveroom-agent.mjs",
    "agent:bundle": "node scripts/build-agent-bundle.mjs",
    "agent:configure": "bash scripts/configure-resolveroom-agent.sh",
    "video:preview": "remotion studio media/remotion/index.tsx --public-dir=docs/assets",
    "video:render": "remotion render media/remotion/index.tsx ResolveRoomWalkthrough docs/assets/resolveroom-walkthrough.mp4 --public-dir=docs/assets --codec=h264 --crf=18",
    "deploy:config": "node scripts/prepare-deploy-config.mjs",
    "deploy:dry-run": "npm run build && npm run deploy:config && wrangler deploy --dry-run --config wrangler.deploy.toml",
    "deploy:secrets": "node scripts/sync-worker-secrets.mjs",
    "deploy:smoke": "bash scripts/smoke-deployment.sh",
    "deploy": "npm run build && npm run deploy:config && wrangler deploy --config wrangler.deploy.toml",
    "check": "npm run agent:bundle && npm run format && npm run lint && npm run typecheck && npm test && npm run test:cli-package && npm run build"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.1",
    "hono": "^4.13.5",
    "lucide-react": "^1.34.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^5.20260826.1",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@remotion/cli": "^4.0.517",
    "@remotion/media": "^4.0.516",
    "@remotion/transitions": "^4.0.517",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^3.2.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "esbuild": "^0.28.2",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "remotion": "^4.0.516",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^8.2.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.126.0",
    "ws": "^8.21.3"
  }
}
